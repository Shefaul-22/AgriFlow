generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FARMER
  BUYER
  DELIVERY_PARTNER
}

enum DeliveryStatus {
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  image     String?

  role      UserRole @default(BUYER)

  deliveries Delivery[]

  orders     Order[]   //  add for orders

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Delivery {
  id         Int            @id @default(autoincrement())
  trackingId String         @unique

  customer   String
  address    String
  phone      String
  items      String
  reward     Float

  status     DeliveryStatus @default(ASSIGNED)

  riderId    Int?
  rider      User? @relation(fields: [riderId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  category    String
  price       Float
  unit        String
  location    String
  seller      String
  image       String
  description String
  stock       Int
  delivery    String
  quality     String
}

model Order {
  id          Int      @id @default(autoincrement())
  productId   Int
  productName String
  delivery    String
  image       String
  price       Float
  quantity    Int
  totalPrice  Float
  seller      String

  userId      Int  
  user        User? @relation(fields: [userId], references: [id])

  
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
}